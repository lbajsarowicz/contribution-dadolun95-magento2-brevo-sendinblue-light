{
    "name": "dadolun95/magento2-brevo-sendinblue-light",
    "description": "Magento2 Brevo (Sendinblue previously) Contact Sync Integration Module",
    "type": "magento2-module",
    "version": "1.0.16",
    "require": {
        "dadolun95/magento2-brevo-sendinblue-core": "^1.0",
        "getbrevo/brevo-php": "^1.0"
    },
    "license": [
        "MIT"
    ],
    "authors": [
        {
            "name": "Davide Lunardon",
            "email": "dadolun@gmail.com",
            "homepage": "https://www.dadolun.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Dadolun\\SibContactSync\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
